        <mxCell id="5" value="Меню зависит от роли: гость, клиент (Корзина, Мои заказы), менеджер (Заказы), администратор (Управление)" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;fillColor=#f4f7f8;strokeColor=#8aa0a8;fontFamily=Times New Roman;fontSize=13;fontColor=#1a1a1a;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="92" width="460" height="36" as="geometry"/></mxCell>
